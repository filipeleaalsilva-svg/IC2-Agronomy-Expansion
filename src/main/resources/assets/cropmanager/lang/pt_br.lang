tile.cropmanager.eu_wifi_point.name=Ponto Wi-Fi de EU
cropmanager.eu_wifi_point_help=Puxa EU de um canal Wi-Fi para cabos ou máquinas IC2 com Tier configurável e controle redstone.
tile.cropmanager.eu_dish_antenna.name=Antena Parabólica de EU
cropmanager.eu_dish_antenna_help=Transmite EU de armazenadores adjacentes ou cabos para máquinas no raio com Upgrade Wireless EU sem vínculo ou vinculado a esta antena.
